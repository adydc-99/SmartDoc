MYSQL_ROOT_PASSWORD=<set-a-strong-mysql-root-password>
MYSQL_PASSWORD=<set-a-strong-mysql-application-password>
MINIO_ACCESS_KEY=smartdoc
MINIO_SECRET_KEY=<set-a-strong-minio-password>
SMARTDOC_AUTH_SECRET=<set-at-least-32-random-characters>
SMARTDOC_AI_MASTER_KEY_BASE64=<base64-encoded-32-random-bytes>

# 本文件只提供 Docker/MySQL/MinIO 的非敏感配置模板。
# AI 服务商密钥只能在运行后的“设置 → AI 服务商”中录入，切勿写入 .env、README 或提交到 Git。
# 未配置默认文本服务商时，SmartDoc 使用无需联网和密钥的 Demo AI。
