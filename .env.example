MYSQL_ROOT_PASSWORD=change-root-password
MYSQL_PASSWORD=change-database-password
MINIO_ACCESS_KEY=smartdoc
MINIO_SECRET_KEY=change-minio-password
SMARTDOC_AUTH_SECRET=replace-with-at-least-32-random-characters
